root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{kt,kts}]
# Matches IntelliJ's Kotlin style guide formatter, so ktlint and the IDE never fight.
ktlint_code_style = intellij_idea
# Composables that emit UI are PascalCase nouns, per the Compose API guidelines.
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{yml,yaml,json}]
indent_size = 2

[*.{xml,plist,xcconfig,pbxproj}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

# Compose generates its resource accessors into build/; their formatting is not ours to fix.
[**/build/**/*.{kt,kts}]
ktlint = disabled
